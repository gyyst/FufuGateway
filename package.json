{
  "name": "fufu-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-protocol AI token gateway on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate:local": "wrangler d1 migrations apply fufu-gateway --local",
    "db:migrate:remote": "wrangler d1 migrations apply fufu-gateway --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "^5.20261030.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  }
}
