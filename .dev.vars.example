# 本地开发密钥（复制为 .dev.vars 后使用；禁止提交 .dev.vars）
# 管理员令牌：用于 /admin/* 与 /ui 登录
ADMIN_TOKEN=change-me-admin-token
# 下游 API Key 哈希盐值（任意高熵字符串，生产环境必须更换）
API_KEY_PEPPER=change-me-api-key-pepper
# 上游密钥加密主密钥：base64 编码的 32 字节随机数
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# 仅限本地开发：允许 http 与私有地址作为上游（生产环境禁止设置）
# ALLOW_PRIVATE_UPSTREAMS=true
